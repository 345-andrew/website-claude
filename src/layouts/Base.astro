---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, integrations } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Landing pages: hide the main navigation; the header CTA links here (e.g. '#book'). */
  landingCta?: string;
}
const { title, description = site.description, landingCta } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const { hubspotPortalId, hubspotRegion, ga4MeasurementId } = integrations;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/logo-blue.png', site.url).href} />

    {ga4MeasurementId && (
      <>
        {/* Google Consent Mode v2: nothing is stored until the visitor accepts
            via the HubSpot cookie banner (enable "Google Consent Mode" in HubSpot). */}
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('consent', 'default', {
            ad_storage: 'denied', ad_user_data: 'denied',
            ad_personalization: 'denied', analytics_storage: 'denied',
            wait_for_update: 500
          });
        </script>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}></script>
        <script is:inline define:vars={{ ga4MeasurementId }}>
          gtag('js', new Date());
          gtag('config', ga4MeasurementId);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header landingCta={landingCta} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {hubspotPortalId && (
      // HubSpot tracking code — also loads the HubSpot cookie consent banner.
      <script is:inline type="text/javascript" id="hs-script-loader" async defer
        src={`//js-${hubspotRegion}.hs-scripts.com/${hubspotPortalId}.js`}></script>
    )}
    <style>
      .skip-link { position: absolute; left: -9999px; }
      .skip-link:focus { left: 16px; top: 16px; z-index: 100; background: #fff; padding: 8px 16px; }
    </style>
  </body>
</html>
