---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base title="About" description="345 Technology specialises in migrating enterprise middleware and integration platforms to modern Azure integration.">
  <section class="section on-dark">
    <div class="container narrow">
      <p class="eyebrow">About 345 Technology</p>
      <h1>Specialists in moving business-critical integration.</h1>
      <p class="lead">We help organisations benefit from better business processes by replacing legacy middleware with modern cloud integration.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Why we exist</h2>
      <p>Integration platforms sit quietly behind almost every business process. When they need replacing, the risk is real and the stakes are high. We focus on this one problem so our customers can approach it with confidence.</p>
      <h2 style="margin-top:40px">What we believe</h2>
      <ul class="checklist">
        <li><strong>Plan first.</strong> An agreed, accountable plan comes before any build work.</li>
        <li><strong>Be open.</strong> Risks, progress and decisions should always be visible.</li>
        <li><strong>Protect operations.</strong> The business process matters more than the technology.</li>
        <li><strong>Make it repeatable.</strong> AI-assisted methods make every migration consistent and governable.</li>
      </ul>
      <!-- TODO: add founding year, named case studies (need written permission) and current certifications -->
    </div>
  </section>

  <section class="section tint">
    <div class="container">
      <div class="narrow">
        <h2>Who you'll work with</h2>
        <p>345 Technology is based in Winchester, UK, and is a Microsoft Solutions Partner for Digital &amp; App Innovation.</p>
      </div>
      <div class="grid grid-4" style="margin-top:32px">
        <div class="card">
          <h3>Dr Andrew Rivers</h3>
          <p class="eyebrow">CEO &amp; co-founder</p>
          <p>Software consulting since 2000.</p>
        </div>
        <div class="card">
          <h3>Paul Brown</h3>
          <p class="eyebrow">CTO &amp; co-founder</p>
        </div>
        <div class="card">
          <h3>James Hockey</h3>
          <p class="eyebrow">Customer Technology Director &amp; co-founder</p>
          <p>Enterprise integration consulting for 20 years.</p>
        </div>
        <div class="card">
          <h3>Isobel Dix</h3>
          <p class="eyebrow">Head of Growth</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
